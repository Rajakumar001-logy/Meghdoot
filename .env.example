# ============================================================================
# MONSOONPULSE AI — ENVIRONMENT CONFIGURATION (.env.example)
# "Predict the Monsoon. Protect the Harvest."
# Copy to .env.local and supply real credentials where applicable.
# Server-side tokens are NEVER prefixed with NEXT_PUBLIC_ and never exposed to clients.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# 2. WEATHER (Open-Meteo Real Telemetry Ingestion)
# ----------------------------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=1800

# ----------------------------------------------------------------------------
# 3. RAINFALL (IMD Gridded / NASA POWER Agroclimatology)
# ----------------------------------------------------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
RAINFALL_CACHE_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# 4. CLIMATE (NOAA CPC ENSO ONI, Indian Ocean Dipole IOD, Australian BoM MJO)
# ----------------------------------------------------------------------------
NOAA_ENSO_DATA_URL=https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt
CLIMATE_CACHE_TTL_SECONDS=21600

# ----------------------------------------------------------------------------
# 5. AI SERVICE (MPAI-ENS-0.1 Python FastAPI Inference Engine)
# ----------------------------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
ML_MODEL_VERSION=MPAI-ENS-0.1

# ----------------------------------------------------------------------------
# 6. WHATSAPP (Server-side Provider Abstraction — Leave empty for NOT_CONFIGURED / SIMULATED)
# ----------------------------------------------------------------------------
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# 7. SMS (Server-side Gateway Abstraction — Leave empty for NOT_CONFIGURED / SIMULATED)
# ----------------------------------------------------------------------------
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=

# ----------------------------------------------------------------------------
# 8. GIS (Prayagraj 8-Block Administrative Boundary Configuration)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GIS_DEFAULT_DISTRICT=Prayagraj
NEXT_PUBLIC_GIS_BOUNDARY_PATH=/gis/prayagraj_blocks.geojson
